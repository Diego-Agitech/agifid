---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const experts = (await reader.collections.experts.all())
  .map((e) => e.entry)
  .sort((a, b) => a.order - b.order);
const hero = await reader.singletons.hero.read();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'AgiFid',
  url: 'https://agifid.be/',
  description: "Fiduciaire agréée membre de l'ITAA, 100% dédiée aux sociétés qui pilotent leur comptabilité, fiscalité et gestion sur Odoo.",
  address: {
    '@type': 'PostalAddress',
    streetAddress: '11 Clos Lucien Outers',
    postalCode: '1160',
    addressLocality: 'Brussels',
    addressCountry: 'BE',
  },
  areaServed: 'BE',
  sameAs: [
    'https://www.linkedin.com/company/agitechbelgium/',
    'https://www.youtube.com/@Agitech-OdooPartner',
  ],
};
---
<Layout
  htmlLang="fr-BE"
  lang="fr"
  pageType="home"
  title="AgiFid — Fiduciaire 100% dédiée aux sociétés sur Odoo"
  description="AgiFid, fiduciaire agréée membre de l'ITAA, et Agitech, intégrateur Odoo certifié : comptabilité, fiscalité, paie & RH et conseil financier pour les sociétés qui pilotent leur activité sur Odoo."
  canonical="https://agifid.be/"
  ogLocale="fr_BE"
  jsonLd={jsonLd}
  includeContactScripts
>
<section class="home-banner" id="hero">
  <div class="container row">
    <h6>{hero.kicker}</h6>
    <h1>{hero.titleBefore} <span>{hero.titleHighlight}</span><br>{hero.titleAfter}</h1>
    <a class="btn btn-light" href="#contact">{hero.ctaLabel}</a>
  </div>
</section>
<div class="brand-bar"></div>




<section class="certified-experts-section" id="experts">
  <div class="container">
    <h6>Partenaire Odoo Silver</h6>
    <h3>Experts Comptables &amp; Odoo</h3>
    <div class="experts-slider">
      {experts.map((expert) => (
        <div class="expert-member">
          <img src={`assets/img/experts/${expert.photo}`} alt={expert.displayName} loading="lazy">
          <div class="expert-info"><h5>{expert.displayName}</h5><h6>{expert.role}</h6></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="why-section" id="pourquoi">
  <div class="container">
    <div class="why-title"><h3>Une méthodologie construite pour Odoo</h3></div>
    <div class="row">
      <div class="why-image">
        <div class="why-img"><img src="assets/img/why-choose-us-sec-img-scaled.jpg" alt="Méthodologie Odoo" loading="lazy"></div>
      </div>
      <div class="why-content">
        <div class="item">
          <h4>01</h4>
          <h5>Comptabilité en temps réel</h5>
          <ul>
            <li>Suivez vos bilans et votre compte de résultat en temps réel : un vrai insight sur votre activité.</li>
            <li>Un responsable unique de votre Odoo. Fini les allers-retours où l'on se rejette la responsabilité.</li>
          </ul>
        </div>
        <div class="item">
          <h4>02</h4>
          <h5>Compréhension du business</h5>
          <ul>
            <li>Votre comptable travaille directement dans Odoo.</li>
            <li>Comptabilité à jour et Dashboard avec KPIs dans Odoo.</li>
          </ul>
        </div>
        <div class="item">
          <h4>03</h4>
          <h5>Devenez autonome</h5>
          <ul>
            <li>Nous vous formons à la comptabilité Odoo.</li>
            <li>Maîtrisez votre compta, devenez autonome.</li>
            <li>Bien encodé de votre part : nous ne vous facturons pas l'encodage.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="odoo-expertise-section">
  <div class="container">
    <h3>Un accompagnement à 360°</h3>
    <div class="odoo-expertise-content">
      <div class="item">
        <div class="icon"><img src="assets/img/base-de-donnees.png" alt="Icône Comptabilité" loading="lazy"></div>
        <h6>Comptabilité</h6>
        <ul>
          <li>Tenue complète de votre comptabilité et obligations légales.</li>
          <li>Établissement des comptes annuels et déclarations TVA.</li>
          <li>Suivi financier fiable pour piloter votre activité en toute sérénité.</li>
        </ul>
      </div>
      <div class="item">
        <div class="icon"><img src="assets/img/diagramme-circulaire.png" alt="Icône Fiscalité" loading="lazy"></div>
        <h6>Fiscalité</h6>
        <ul>
          <li>Déclarations fiscales pour particuliers, indépendants et sociétés.</li>
          <li>Optimisation fiscale dans le respect de la législation.</li>
          <li>Accompagnement lors de contrôles et démarches administratives.</li>
        </ul>
      </div>
      <div class="item">
        <div class="icon"><img src="assets/img/conseiller-financier.png" alt="Icône Paie et Ressources Humaines" loading="lazy"></div>
        <h6>Paie &amp; Ressources Humaines</h6>
        <ul>
          <li>Gestion des salaires et des déclarations sociales.</li>
          <li>Accompagnement dans l'administration du personnel.</li>
          <li>Conseils en matière de rémunération et de gestion RH.</li>
        </ul>
      </div>
      <div class="item">
        <div class="icon"><img src="assets/img/analytique.png" alt="Icône Analyse et Conseil Financier" loading="lazy"></div>
        <h6>Analyse et Conseil Financier</h6>
        <ul>
          <li>Analyse de la rentabilité et de la performance de votre entreprise.</li>
          <li>Élaboration de budgets, prévisions et plans financiers.</li>
          <li>Conseils stratégiques pour soutenir votre croissance.</li>
        </ul>
      </div>
      <div class="item">
        <div class="icon"><img src="assets/img/bouclier.png" alt="Icône Juridique" loading="lazy"></div>
        <h6>Juridique</h6>
        <ul>
          <li>Assistance dans les formalités juridiques de votre société.</li>
          <li>Rédaction et suivi des documents administratifs essentiels.</li>
          <li>Conseils pour assurer la conformité de votre activité.</li>
        </ul>
      </div>
      <div class="item">
        <div class="icon"><img src="assets/img/codage.png" alt="Icône Digitalisation et tableaux de bord" loading="lazy"></div>
        <h6>Digitalisation &amp; tableaux de bord</h6>
        <ul>
          <li>Mise en place d'outils numériques adaptés à votre entreprise.</li>
          <li>Automatisation des processus comptables et administratifs.</li>
          <li>Tableaux de bord interactifs pour suivre vos indicateurs clés en temps réel.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="our-services-section" id="services">
  <div class="container">
    <div class="title">
      <h2>Nos offres &amp; services</h2>
      <h6>On s'adapte à votre situation : la compta, la tech, ou les deux. C'est vous qui choisissez.</h6>
    </div>
    <div class="our-services-content">
      <div class="item">
        <a class="item-wrap" href="#contact">
          <h4>Management company</h4>
          <ul>
            <li>✓ Comptes annuels &amp; dépôt BNB</li>
            <li>✓ Déclarations TVA périodiques</li>
            <li>✓ Déclaration à l'impôt des sociétés (ISOC)</li>
            <li>✓ 1h formation Odoo encodage &amp; gestion compta</li>
            <li>✓ 1h commentaire des comptes annuels</li>
            <li>✓ 2h optimisation fiscale &amp; rémunération du dirigeant</li>
            <li>✓ Bonus client exemplaire</li>
            <li>✗ Payroll</li>
            <li>✗ Contrôle de gestion</li>
          </ul>
          <span class="light-page-link">3 500 € / an</span>
        </a>
      </div>
      <div class="item">
        <a class="item-wrap" href="#contact">
          <h4>1 à 5 ETP</h4>
          <ul>
            <li>✓ Comptes annuels &amp; dépôt BNB</li>
            <li>✓ Déclarations TVA périodiques</li>
            <li>✓ Déclaration à l'impôt des sociétés (ISOC)</li>
            <li>✓ 1h formation Odoo encodage &amp; gestion compta</li>
            <li>✓ 2h commentaire des comptes annuels</li>
            <li>✓ 3h optimisation fiscale &amp; rémunération du dirigeant</li>
            <li>✓ Bonus client exemplaire</li>
            <li>✓ Payroll inclus (≤ 5 travailleurs)</li>
            <li>✓ Contrôle de gestion</li>
          </ul>
          <span class="light-page-link">6 500 € / an</span>
        </a>
      </div>
      <div class="item">
        <a class="item-wrap" href="#contact">
          <h4>Plus de 5 ETP</h4>
          <ul>
            <li>✓ Comptes annuels &amp; dépôt BNB</li>
            <li>✓ Déclarations TVA périodiques</li>
            <li>✓ Déclaration à l'impôt des sociétés (ISOC)</li>
            <li>✓ 1h formation Odoo encodage &amp; gestion compta</li>
            <li>✓ 2h commentaire des comptes annuels</li>
            <li>✓ 3h optimisation fiscale &amp; rémunération du dirigeant</li>
            <li>✓ Bonus client exemplaire</li>
            <li>✓ Payroll inclus (≤ 5 travailleurs)</li>
            <li>✓ Contrôle de gestion</li>
          </ul>
          <span class="light-page-link">Prix sur demande</span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="union-section">
  <div class="container">
    <h3>AgiFid &amp; Agitech — intégrateur et comptable, enfin réunis.</h3>
    <p class="union-note">AgiFid et Agitech sont deux entités juridiquement et opérationnellement indépendantes, qui collaborent étroitement pour vous offrir un accompagnement coordonné.</p>
    <div class="union-diagram">
      <div class="union-node">
        <div class="tag">Comptable agréé</div>
        <div class="name"><img src="assets/img/logo-agifid-dark.png" alt="AgiFid" loading="lazy"></div>
        <div class="role">Comptabilité, fiscalité, conseil</div>
      </div>
      <div class="union-plus">+</div>
      <div class="union-node">
        <div class="tag">Intégrateur certifié</div>
        <div class="name"><a href="https://agitech.io" target="_blank" rel="noopener"><img src="assets/img/agitech-logo-dark.svg" alt="Agitech" loading="lazy"></a></div>
        <div class="role">Odoo, ERP, infrastructure IT</div>
      </div>
    </div>
    <div class="union-grid">
      <div class="card">
        <h5>Une vraie approche holistique</h5>
        <p>Les business analysts Agitech vous apportent des insights concrets pour piloter votre activité — pas juste rester en règle.</p>
      </div>
      <div class="card">
        <h5>Plus de renvoi de responsabilité</h5>
        <p>L'intégrateur gère Odoo, le comptable gère la compta — avec une coordination directe entre les deux équipes.</p>
      </div>
      <div class="card">
        <h5>Une seule facture</h5>
        <p>Dès lors que la gestion et la comptabilité passent par Odoo via Agitech et AgiFid, tout est réuni sur une seule facture.</p>
      </div>
      <div class="card">
        <h5>De vrais comptables sur vos projets de gestion</h5>
        <p>Votre comptable n'est pas qu'un encodeur : il intervient directement sur vos projets de gestion.</p>
      </div>
    </div>
  </div>
</section>

<section class="methodology-section" id="methodologie">
  <div class="container">
    <div class="row">
      <div class="title">
        <img src="https://www.itaa.be/wp-content/uploads/logo_itaa_transparant.svg" alt="Logo ITAA" style="height:44px; width:auto; margin-bottom:1.25rem;" loading="lazy">
        <h3>Membre de l'ITAA</h3>
      </div>
      <div class="content">
        <div class="para-text"><h6>Votre garantie d'un accompagnement professionnel, réglementé et de qualité.</h6></div>
        <div class="row">
          <div class="methodology-content"><div class="item"><h4>01</h4><h5>Expertise certifiée</h5><p>Des compétences reconnues et validées par l'Institut des Conseillers Fiscaux et des Experts-Comptables.</p></div></div>
          <div class="methodology-content"><div class="item"><h4>02</h4><h5>Formation continue</h5><p>Une mise à jour permanente de nos connaissances pour vous offrir des conseils toujours pertinents.</p></div></div>
          <div class="methodology-content"><div class="item"><h4>03</h4><h5>Déontologie stricte</h5><p>Un engagement fort en matière d'éthique, de confidentialité et d'indépendance.</p></div></div>
          <div class="methodology-content"><div class="item"><h4>04</h4><h5>Protection du client</h5><p>Un cadre réglementé qui garantit la qualité des services et la sécurité de votre accompagnement.</p></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="trust-us-section" id="confiance">
  <div class="container">
    <div class="title">
      <h3>98 PME nous font déjà confiance</h3>
      <h6>Patron de PME, nous savons que la qualité d'un ERP se mesure à son impact réel sur votre entreprise, pas au nombre de fonctionnalités.</h6>
    </div>
    <div class="logos-marquee">
      <div class="companies-logos" id="logosTrack">
        <div class="item"><img src="assets/img/Image-logo-proactivedrive.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image23.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image22.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image41.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image40.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image39.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image-logo-supersec.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image37.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image35.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image34.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image33.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image36.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image32.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image31.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image30.png" alt="" loading="lazy"></div>
        <!-- duplicated set below for seamless marquee loop -->
        <div class="item"><img src="assets/img/Image-logo-proactivedrive.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image23.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image22.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image41.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image40.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image39.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image-logo-supersec.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image37.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image35.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image34.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image33.png" alt="" loading="lazy"></div>
