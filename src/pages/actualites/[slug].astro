---
import Layout from '../../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Markdoc from '@markdoc/markdoc';
import { addTocIds } from '../../lib/toc';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const posts = await reader.collections.blog.all();
  return posts
    .filter((p) => p.entry.published)
    .map((p) => ({ params: { slug: p.slug }, props: { entry: p.entry } }));
}

const { entry } = Astro.props;
const { node } = await entry.content();
const rendered = Markdoc.renderers.html(Markdoc.transform(node));
const { html: bodyHtml, toc } = addTocIds(rendered);

const wordCount = rendered.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));
const publishedDate = new Date(entry.date).toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric' });

const canonical = `https://agifid.be/actualites/${Astro.params.slug}.html`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.title,
  description: entry.excerpt,
  datePublished: entry.date,
  author: { '@type': 'Organization', name: entry.author },
  publisher: { '@type': 'Organization', name: 'AgiFid' },
  mainEntityOfPage: canonical,
};
---
<Layout
  htmlLang="fr-BE"
  lang="fr"
  pageType="sub"
  title={`${entry.title} — Actualités AgiFid`}
  description={entry.excerpt}
  canonical={canonical}
  ogLocale="fr_BE"
  jsonLd={jsonLd}
>
<section class="blog-article-section">
  <div class="container">
    <a class="blog-back-link" href="/actualites.html">← Retour aux actualités</a>
    <div class="blog-article-header">
      {entry.category && <span class="blog-category-tag" data-category={entry.category}>{entry.category}</span>}
      <h1>{entry.title}</h1>
      <div class="blog-article-meta">
        <span class="blog-card-date">{publishedDate}</span>
        <span class="blog-article-dot">·</span>
        <span>{entry.author}</span>
        <span class="blog-article-dot">·</span>
        <span>{readingTime} min de lecture</span>
      </div>
      <p class="blog-article-excerpt">{entry.excerpt}</p>
    </div>
    {entry.coverImage && <img class="blog-article-cover" src={`/assets/img/blog/${entry.coverImage}`} alt={entry.title} loading="lazy" />}
    <div class="blog-article-layout">
      {toc.length > 1 && (
        <aside class="blog-toc">
          <nav>
            <h6>Sommaire</h6>
            <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
      <div class="blog-article-body" set:html={bodyHtml} />
    </div>
    <div class="blog-article-cta">
      <h5>Une question sur votre comptabilité ?</h5>
      <p>Parlez-en directement avec un expert AgiFid, sans blabla commercial.</p>
      <a class="btn btn-violet" href="/index.html#contact">Parler à un expert</a>
    </div>
  </div>
</section>
</Layout>
